classDiagram
direction TB

class Producto {
  <<abstract>>
  #_nombre: str
  #_precio: float
  +nombre: str
  +precio: float
  +calcular_precio()* float
  +esta_disponible(dia: str)* bool
  +contar_platos()* int
  +calcular_descuento() float
}
class Combo {
  #_productos: list~Producto~
  +descuento: float = 0.10
  +agregar_producto(producto: Producto) None
  +quitar_producto(producto: Producto) None
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
}
class Plato {
  #_dias_disponibles: set~str~
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
}
class Bebida {
  #_tipo: str
  #_presentacion: str
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
}

class Cliente {
  #_nombre: str
  #_telefono: str
  +nombre: str
  +telefono: str
}
class PedidoProducto {
  #_producto: Producto
  #_cantidad: int
  +calcular_subtotal() float
  +calcular_descuento() float
  +contar_platos() int
}
class Pedido {
  <<abstract>>
  #_numero_pedido: int
  #_cliente: Cliente
  #_fecha_registro: datetime
  #_estado: str
  #_items: list~PedidoProducto~
  #_metodo_pago: MetodoPago
  +tipo_pedido: str
  +agregar_producto(producto: Producto, cantidad: int) None
  +quitar_producto(producto: Producto) None
  +calcular_subtotal() float
  +calcular_descuentos() float
  +calcular_cargos()* float
  +calcular_total() float
  +cambiar_estado(estado: str) None
  +cancelar() None
  +cobrar(metodo_pago: MetodoPago) dict
  +detalle() dict
}
class PedidoLocal {
  #_mesa: int
  +tipo_pedido: str
  +numero_mesa: int
  +calcular_cargos() float
}
class PedidoParaLlevar {
  #_costo_envase_por_plato: float = 2
  +tipo_pedido: str
  +calcular_cargos() float
}
class PedidoDelivery {
  #_zona: str
  +PEDIDO_MINIMO: float = 40
  +ENVIO_GRATIS_CERCADO_DESDE: float = 150
  +tipo_pedido: str
  +calcular_cargos() float
  +validar_pedido_minimo() bool
  +cobrar(metodo_pago: MetodoPago) dict
}

class MetodoPago {
  <<abstract>>
  #_monto_pagado: float
  +nombre: str
  +permite_delivery: bool
  +procesar_pago(total: float)* dict
}
class PagoEfectivo {
  #_monto_recibido: float
  +calcular_cambio(total: float) float
  +procesar_pago(total: float) dict
}
class PagoQR {
  #_codigo_transaccion: str
  +procesar_pago(total: float) dict
}
class PagoTarjeta {
  #_porcentaje_comision: float = 0.03
  +calcular_comision(total: float) float
  +procesar_pago(total: float) dict
}

class Restaurante {
  #_nombre: str
  #_productos: list~Producto~
  #_clientes: list~Cliente~
  #_pedidos: list~Pedido~
  +registrar_producto(producto: Producto) None
  +registrar_cliente(cliente: Cliente) None
  +registrar_pedido(pedido: Pedido) None
  +listar_menu_disponible(dia: str) tuple
  +mesa_disponible(mesa: int) bool
  +reporte_ventas(fecha: date) dict
}

Producto <|-- Combo
Producto <|-- Plato
Producto <|-- Bebida
Pedido <|-- PedidoLocal
Pedido <|-- PedidoParaLlevar
Pedido <|-- PedidoDelivery
MetodoPago <|-- PagoEfectivo
MetodoPago <|-- PagoQR
MetodoPago <|-- PagoTarjeta

Combo "1" *-- "2..*" Producto : contiene
Producto "1" <-- "0..*" PedidoProducto : referencia
Pedido "1" *-- "0..*" PedidoProducto : contiene
Cliente "1" --> "0..*" Pedido : realiza
Pedido "1" --> "0..1" MetodoPago : usa
Restaurante "1" o-- "0..*" Producto : administra
Restaurante "1" o-- "0..*" Cliente : registra
Restaurante "1" o-- "0..*" Pedido : gestiona

note for Combo "Cambios 1 y 3: Combo hereda de Producto; se elimina ComboProducto y se representa la composición 1 a 2..*."
note for PedidoProducto "Cambio 2: cantidad sale de Producto y pasa a PedidoProducto."
note for Producto "Cambio 4: se agregan los contratos abstractos de precio, disponibilidad y conteo de platos."
note for Pedido "Cambios 5 y 6: se renombran las hijas y se agregan ítems, fecha, pago, descuentos, cargos, total y cobro."
note for MetodoPago "Cambios 7 y 8: Pago se renombra MetodoPago y procesar_pago se vuelve abstracto y polimórfico."
note for Restaurante "Cambios 9 y 10: se agrega la gestora con sus relaciones, multiplicidades, tipos y visibilidad."
note for PedidoDelivery "Cambios 11 y 12: se incorpora la variante A y se elimina retraso/compensación por decisión del docente."
