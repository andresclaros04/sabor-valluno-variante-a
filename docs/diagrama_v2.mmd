class Producto {
  <<abstract>>
  #_nombre: str
  #_precio: float
  +nombre: str
  +precio: float
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
  +contiene(producto: Producto) bool
}
class Plato {
  #_dias_disponibles: set~str~
  +dias_disponibles: tuple
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
}
class Bebida {
  #_tipo: str
  #_presentacion: str
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
}
class Combo {
  #_productos: list~Producto~
  +productos: tuple
  +descuento: float
  +agregar_producto(producto: Producto) None
  +quitar_producto(producto: Producto) None
  +calcular_precio() float
  +esta_disponible(dia: str) bool
  +contar_platos() int
}

class Cliente {
  #_nombre: str
  #_telefono: str
